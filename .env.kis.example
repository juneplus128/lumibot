# 한국투자증권(KIS) Open API 설정 견본
# 이 파일을 복사해서 .env 에 붙여 넣고 값을 채우세요. .env 는 절대 커밋하지 마세요.
# 앱키·앱시크릿은 KIS Developers(apiportal.koreainvestment.com)에서 발급 (모의투자용과 실전용이 따로 있음)

# 이 두 줄이 있으면 Strategy() 가 자동으로 KIS 를 쓴다 (코드에서 KIS() 를 만들 필요 없음)
TRADING_BROKER=kis
DATA_SOURCE=kis

KIS_APP_KEY=<your-kis-app-key>
KIS_APP_SECRET=<your-kis-app-secret>
# 계좌번호: "12345678-01" 형식, 또는 앞 8자리만 (뒤 2자리는 KIS_ACCOUNT_PRODUCT, 기본 01)
KIS_ACCOUNT_NO=<your-account-number>
# KIS_ACCOUNT_PRODUCT=01

# true = 모의투자 (기본값). 실전으로 바꾸기 전에 팀과 꼭 상의할 것
KIS_IS_PAPER=true
# 실전(진짜 돈)은 KIS_IS_PAPER=false 와 아래 줄을 '둘 다' 바꿔야 동작한다 (실전 이중 잠금)
# KIS_ALLOW_REAL=true

# 토큰 저장 파일 (기본: kis_token_paper.json / kis_token_real.json, .gitignore 에 등록됨)
# KIS_TOKEN_FILE=kis_token_paper.json
