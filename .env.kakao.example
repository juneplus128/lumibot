# ===== 카카오톡 매매 알리미 설정 =====
# = 뒤에 카카오 콘솔에서 복사한 값을 붙여넣고 저장하세요. (따옴표, 띄어쓰기 없이)
# 저장한 다음 터미널에서:  lumibot kakao login

# [필수] 카카오 콘솔 [앱] → [플랫폼 키] → [REST API 키] 화면의 "REST API 키"
KAKAO_REST_API_KEY=

# [켰을 때만] 같은 화면의 "카카오 로그인" 클라이언트 시크릿 (비즈니스 인증용 아님). 안 켰으면 비워두기
KAKAO_CLIENT_SECRET=

# [알림 켜기] true 면 체결 · 취소 · 장 마감 요약이 카톡으로 와요
KAKAO_TRADE_ALERTS=true

# ----- 아래는 선택 (바꾸고 싶을 때만 앞의 # 을 지우세요) -----
# KAKAO_DAILY_SUMMARY=false         장 마감 요약 끄기
# KAKAO_ALERT_IN_BACKTEST=true      백테스트에서도 카톡 받기
# KAKAO_BACKTEST_MAX_ALERTS=5       백테스트 한 번에 최대 메시지 수 (기본 20)
